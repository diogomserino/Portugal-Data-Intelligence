# =============================================================================
# Portugal Data Intelligence - .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl

# Virtual Environments
venv/
env/
.env/
.venv/
ENV/

# Environment Variables / Secrets
.env
.env.local
.env.*.local
*.secret
api_keys.json

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data Files (large files - keep structure, ignore content)
# NB: data/raw/*.csv is the committed, deterministic raw snapshot (tracked on purpose
# so `python main.py` rebuilds the same dataset offline; use --refresh to re-fetch).
data/raw/*.xlsx
data/raw/*.xls
data/raw/*.json
data/raw/*.sha256
data/raw/*.meta.json
data/processed/*.csv
data/processed/*.xlsx
data/processed/*.parquet
data/database/*.db
data/database/*.sqlite
data/database/*.sqlite3
# SQLite WAL-mode transient files
data/database/*.db-shm
data/database/*.db-wal
# Cached forecast models (regenerated by joblib, never load untrusted .pkl)
data/models/*.pkl
data/models/*.joblib
# Reference geodata cache (downloaded on demand from Eurostat GISCO)
data/reference/*.geojson

# Logs
logs/
*.log

# Generated HTML reports
dashboard/pages/*.html
dashboard/*.html

# Reports (generated outputs)
# reports/powerbi/*.pbix  # tracked — Power BI report included in repo
# reports/powerbi/charts/*.png  # tracked for README display
reports/powerpoint/*.pptx
reports/powerpoint/*.pdf
reports/insights/*.json
reports/data_quality/*.json
reports/alerts/*.json
reports/*.xlsx
reports/powerbi/charts/stl_unit_test_series.png
PROGRESS.md
reports/backtesting_results.json
reports/ad_hoc/*.png

# MkDocs build output
site/

# OS Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Distribution / Packaging
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# mypy
.mypy_cache/
.claude/

# API cache
.api_cache/

# Local audit / validation working notes (not for publication)
AUDIT_FINDINGS.md
DATA_VALIDATION.md
